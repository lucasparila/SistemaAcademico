	                    	               int faltas = Integer.parseInt(faltasStr);
	                    	               
	                    	               matricula.getFrequencia().adicionarAulas(aulasDadas);
	                    	               matricula.getFrequencia().registrarFaltas(faltas);
	                    	               
	                    	               JOptionPane.showMessageDialog(null, "Frequência atualizada para " + matricula.getPercentualFrequencia() + "%");
	                    	           } catch (NumberFormatException e) {
	                    	        	   JOptionPane.showMessageDialog(null, "Erro: Digite valores numéricos válidos.");
	                    	               
	                    	            }
	                    	          
				                    	 
			                    }
			                    	 
	                        }
	                         
	                         break;
	
	                     default:
	                         JOptionPane.showMessageDialog(null, "Opção inválida. Tente novamente.");
	                 }
	        	 }
	        	
	        }else if(usuario instanceof Aluno && !tipoUsuario.equals("0")) {
	        	

	        	
	        	 while (true) {
	                 String menu = "Aluno " + usuario.getNome() + "\n"
	                         + "1. Visualizar turmas\n"
	                         + "2. Inscrever-se em uma turma\n"
	                         + "3. Boletim\n"
	                         + "0. Sair\n";
	                 
	                 String opcao = JOptionPane.showInputDialog(menu);
	
	                 if (opcao == null || opcao.equals("0")) {
	                     JOptionPane.showMessageDialog(null, "Voltando ao menu princiapal...");
	                     break;
	                 }
	             
	
	                 switch (opcao) {
	                     case "1":
	                         // Visualizar turmas	                                   
	                         String turmasList = ((Aluno) usuario).visualizarTurmasDisponiveis(admin);
	                         JOptionPane.showMessageDialog(null, turmasList);
	                         break;
	
	                     case "2":
	                         // Inscrever-se em uma turma	                    	 	                    	                 	 
	                         String codigoTurma = JOptionPane.showInputDialog("Digite o codigo da turma:");	                         
	                         Turma turma = ((Aluno) usuario).buscarTurmaParaInscrever(admin, codigoTurma);
	                         if(turma == null) {
	                        	 JOptionPane.showMessageDialog(null, "Não existe nenhuma turma com o código informado.");
	                         }else {
	                        	 JOptionPane.showMessageDialog(null,((Aluno) usuario).solicitarMatricula(admin, turma, (Aluno) usuario));
	                         }
	                         break;
	
	                     case "3":
	                         // boletim 
	                    	 String listMatriculas = usuario.visualizarMatriculas();
	                    	 JOptionPane.showMessageDialog(null, listMatriculas);
	                         break;
	
	                     default:
	                         JOptionPane.showMessageDialog(null, "Opção inválida. Tente novamente.");
	                 }
	        	 }
	        	
	        }
	        
        if(tipoUsuario.equals("0")) {
        	JOptionPane.showMessageDialog(null, "Saindo do sistema...");							
        }
    }while(!tipoUsuario.equals("0"));
 }
